	pages = {70--85},
	file = {978-3-031-95976-9_5:D\:\\Shankar\\goat-ipython\\goat-vault\\goat-vault\\01 - Notes\\03 - Resources\\France\\acads\\internship-docs\\projects\\JGP-SSP-Codes-Shankar\\references\\Useless\\new\\978-3-031-95976-9_5.pdf:application/pdf},
