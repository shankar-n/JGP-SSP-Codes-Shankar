@article{gutin_memetic_2010,
	title = {A memetic algorithm for the generalized traveling salesman problem},
	volume = {9},
	copyright = {http://www.springer.com/tdm},
	issn = {1567-7818, 1572-9796},
	url = {http://link.springer.com/10.1007/s11047-009-9111-6},
	doi = {10.1007/s11047-009-9111-6},
	abstract = {The generalized traveling salesman problem (GTSP) is an extension of the well-known traveling salesman problem. In GTSP, we are given a partition of cities into groups and we are required to ﬁnd a minimum length tour that includes exactly one city from each group. The recent studies on this subject consider different variations of a memetic algorithm approach to the GTSP. The aim of this paper is to present a new memetic algorithm for GTSP with a powerful local search procedure. The experiments show that the proposed algorithm clearly outperforms all of the known heuristics with respect to both solution quality and running time. While the other memetic algorithms were designed only for the symmetric GTSP, our algorithm can solve both symmetric and asymmetric instances.},
	language = {en},
	number = {1},
	urldate = {2026-08-26},
	journal = {Natural Computing},
	author = {Gutin, Gregory and Karapetyan, Daniel},
	month = mar,
